<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
	Lint leve: trava as convenções que o código já segue (tabs, sem imports
	com *, sem espaço no fim da linha, até 120 colunas) e pega erros comuns.
	Não impõe um estilo novo.
-->
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="error"/>
	<property name="tabWidth" value="4"/>

	<module name="NewlineAtEndOfFile"/>
	<module name="LineLength">
		<property name="max" value="120"/>
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="message" value="Espaço em branco no fim da linha"/>
	</module>
	<module name="RegexpSingleline">
		<!-- indentação é com tab; espaços só alinhando o '*' de javadoc -->
		<property name="format" value="^\t* +[^ *]"/>
		<property name="message" value="Indente com tabs, não espaços"/>
	</module>

	<module name="TreeWalker">
		<!-- imports -->
		<module name="AvoidStarImport"/>
		<module name="RedundantImport"/>
		<module name="UnusedImports"/>

		<!-- erros comuns -->
		<module name="EqualsHashCode"/>
		<module name="StringLiteralEquality"/>
		<module name="EmptyStatement"/>
		<module name="EmptyCatchBlock">
			<!-- catch vazio só com comentário explicando o porquê -->
			<property name="commentFormat" value=".+"/>
		</module>
		<module name="FallThrough"/>
		<module name="OneStatementPerLine"/>
		<module name="UpperEll"/>
		<module name="ArrayTypeStyle"/>
		<module name="ModifierOrder"/>
		<module name="RedundantModifier"/>

		<!-- logs vão pelo LOGGER, nunca pelo console -->
		<module name="Regexp">
			<property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
			<property name="illegalPattern" value="true"/>
			<property name="message" value="Use SimpleMusicBox.LOGGER"/>
		</module>
	</module>
</module>
